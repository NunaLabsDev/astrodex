{
  "name": "astrodex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm -r lint",
    "test": "vitest run",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check": "pnpm --filter \"./packages/*\" build && pnpm -r typecheck && pnpm -r lint && pnpm test && pnpm secret-scan && pnpm --filter @astrodex/tma build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
